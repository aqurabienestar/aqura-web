---
import SelectorIdioma from './SelectorIdioma.astro';
import IconoWhatsapp from './IconoWhatsapp.astro';
import {
  enlaceWhatsapp,
  idiomaDesdeUrl,
  menuPrincipal,
  rutaBase,
  rutaEn,
  textos,
} from '../i18n';

interface Props {
  whatsappMensaje: string;
}

const { whatsappMensaje } = Astro.props;
const idioma = idiomaDesdeUrl(Astro.url);
const t = textos(idioma);
const actual = rutaBase(Astro.url.pathname).replace(/\/$/, '') || '/';

const esActual = (ruta: string) => actual === ruta;
const contieneActual = (ruta: string) => actual === ruta || actual.startsWith(`${ruta}/`);
const whatsapp = enlaceWhatsapp(whatsappMensaje);
---
<header class="header">
  <div class="contenedor header__barra">
    <a class="header__logo" href={rutaEn(idioma, '/')} aria-label={t.ui.inicio}>
      <img src="/logos/aqura-logotipo-azul.png" alt="" width="118" height="28" />
    </a>

    <div class="header__panel" id="menu-principal" data-abierto="false">
      <nav aria-label={t.ui.menuPrincipal}>
        <ul class="menu">
          {menuPrincipal.map((item) =>
            item.hijos ? (
              <li class:list={['menu__item', 'menu__item--grupo', { 'es-activo': contieneActual(item.ruta) }]}>
                <button
                  type="button"
                  class="menu__enlace menu__boton"
                  aria-expanded="false"
                  aria-controls={`sub-${item.clave}`}
                >
                  {t.nav[item.clave]}
                  <svg class="menu__flecha" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                    <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <ul class="submenu" id={`sub-${item.clave}`}>
                  {item.hijos.map((hijo) => (
                    <li>
                      <a
                        class="submenu__enlace"
                        href={rutaEn(idioma, hijo.ruta)}
                        aria-current={esActual(hijo.ruta) ? 'page' : undefined}
                      >{t.nav[hijo.clave]}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : item.externo ? (
              <li class="menu__item">
                <a class="menu__enlace" href={item.ruta} target="_blank" rel="noopener">
                  {t.nav[item.clave]}
                  <svg class="menu__externo" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                    <path d="M4 2.5h5.5V8M9.5 2.5 2.5 9.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="sr-only">{t.ui.pestanaNueva}</span>
                </a>
              </li>
            ) : (
              <li class:list={['menu__item', { 'es-activo': contieneActual(item.ruta) }]}>
                <a
                  class="menu__enlace"
                  href={rutaEn(idioma, item.ruta)}
                  aria-current={esActual(item.ruta) ? 'page' : undefined}
                >{t.nav[item.clave]}</a>
              </li>
            )
          )}
        </ul>
      </nav>

      <a class="btn btn--primario header__whatsapp-panel" href={whatsapp} target="_blank" rel="noopener">
        <IconoWhatsapp />
        {t.ui.whatsapp}
        <span class="sr-only">{t.ui.pestanaNueva}</span>
      </a>
    </div>

    <div class="header__acciones">
      <SelectorIdioma />
      <a class="btn btn--primario header__whatsapp" href={whatsapp} target="_blank" rel="noopener">
        <IconoWhatsapp />
        {t.ui.whatsapp}
        <span class="sr-only">{t.ui.pestanaNueva}</span>
      </a>
      <button
        type="button"
        class="header__toggle"
        aria-controls="menu-principal"
        aria-expanded="false"
        data-abrir={t.ui.abrirMenu}
        data-cerrar={t.ui.cerrarMenu}
      >
        <span class="header__toggle-lineas" aria-hidden="true"><span></span></span>
        <span class="sr-only">{t.ui.abrirMenu}</span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    border-bottom: 1px solid var(--color-borde);
  }
  @supports (backdrop-filter: blur(8px)) {
    .header { background: rgb(255 255 255 / 0.88); backdrop-filter: blur(8px); }
  }

  .header__barra {
    display: flex;
    align-items: center;
    gap: var(--espacio-4);
    min-height: var(--alto-header);
  }

  /* Área de protección del logo: margen libre alrededor del logotipo */
  .header__logo {
    display: block;
    flex: none;
    padding-block: var(--espacio-3);
    margin-right: auto;
  }
  .header__logo img { width: 118px; height: 28px; }

  .header__acciones {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
  }
  .header__whatsapp { display: none; }

  /* ---------- Botón de menú (celular) ---------- */
  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: calc(var(--espacio-2) * -1);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-texto);
    cursor: pointer;
  }
  .header__toggle-lineas,
  .header__toggle-lineas::before,
  .header__toggle-lineas::after,
  .header__toggle-lineas span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--transicion), opacity var(--transicion);
  }
  .header__toggle-lineas { position: relative; background: transparent; }
  .header__toggle-lineas::before,
  .header__toggle-lineas::after { content: ''; position: absolute; left: 0; }
  .header__toggle-lineas::before { top: -6px; }
  .header__toggle-lineas::after { top: 6px; }
  .header__toggle[aria-expanded='true'] .header__toggle-lineas span { opacity: 0; }
  .header__toggle[aria-expanded='true'] .header__toggle-lineas::before { transform: translateY(6px) rotate(45deg); }
  .header__toggle[aria-expanded='true'] .header__toggle-lineas::after { transform: translateY(-6px) rotate(-45deg); }

  /* ---------- Panel (celular) ---------- */
  .header__panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - var(--alto-header));
    max-height: calc(100dvh - var(--alto-header));
    overflow-y: auto;
    padding: var(--espacio-4) var(--margen-lateral) var(--espacio-7);
    background: var(--color-blanco);
    border-bottom: 1px solid var(--color-borde);
    box-shadow: var(--sombra-suave);
  }
  .header__panel[data-abierto='true'] { display: block; }

  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu li + li { margin-top: 0; }
  .menu__item { border-bottom: 1px solid var(--color-borde); }

  .menu__enlace {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    width: 100%;
    min-height: 3.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-texto);
    font-family: var(--font-titulos);
    font-size: 1.0625rem;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .menu__enlace:hover { color: var(--color-azul-oscuro); }
  .menu__enlace[aria-current='page'],
  .es-activo > .menu__enlace { color: var(--color-azul-oscuro); font-weight: 600; }

  .menu__flecha {
    width: 0.8em;
    height: 0.8em;
    margin-left: auto;
    transition: transform var(--transicion);
  }
  .menu__boton[aria-expanded='true'] .menu__flecha { transform: rotate(180deg); }
  .menu__externo { width: 0.7em; height: 0.7em; opacity: 0.7; }

  .submenu {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--espacio-3) var(--espacio-4);
  }
  .menu__boton[aria-expanded='false'] + .submenu { display: none; }
  .submenu li + li { margin-top: 0; }

  .submenu__enlace {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-texto);
    font-family: var(--font-titulos);
    font-size: var(--texto-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .submenu__enlace:hover,
  .submenu__enlace[aria-current='page'] { color: var(--color-azul-oscuro); }
  .submenu__enlace[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-turquesa);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .header__whatsapp-panel { width: 100%; margin-top: var(--espacio-5); }

  /* ---------- Escritorio ---------- */
  @media (min-width: 960px) {
    .header__barra { gap: var(--espacio-6); }
    .header__logo img { width: 135px; height: 32px; }
    .header__logo { margin-right: 0; }

    .header__toggle,
    .header__whatsapp-panel { display: none; }
    .header__whatsapp { display: inline-flex; margin-left: var(--espacio-3); }

    .header__panel,
    .header__panel[data-abierto='false'] {
      display: block;
      position: static;
      flex: 1;
      max-height: none;
      overflow: visible;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .menu {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(1rem, 2.2vw, 2.25rem);
    }
    .menu__item { position: relative; border: 0; }

    .menu__enlace {
      width: auto;
      min-height: var(--alto-header);
      font-size: var(--texto-sm);
      position: relative;
    }
    .menu__enlace::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 1.35rem;
      height: 2px;
      background: var(--color-turquesa);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--transicion);
    }
    .menu__enlace:hover::after,
    .menu__enlace[aria-current='page']::after,
    .es-activo > .menu__enlace::after { transform: scaleX(1); }
    .menu__flecha { margin-left: 0; }

    .submenu {
      position: absolute;
      top: calc(100% - 0.75rem);
      left: -1.25rem;
      min-width: 13rem;
      padding: var(--espacio-3) 0;
      background: var(--color-blanco);
      border: 1px solid var(--color-borde);
      border-radius: var(--radio-md);
      box-shadow: var(--sombra-suave);
    }
    .submenu__enlace { padding-inline: 1.25rem; }
    .submenu__enlace:hover { background: rgb(68 216 197 / 0.12); }
  }

  @media (min-width: 960px) and (hover: hover) {
    .menu__item--grupo:hover > .submenu { display: block; }
    .menu__item--grupo:hover .menu__flecha { transform: rotate(180deg); }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const panel = document.getElementById('menu-principal');
  const escritorio = window.matchMedia('(min-width: 960px)');

  function abrirPanel(abrir: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(abrir));
    panel.dataset.abierto = String(abrir);
    const etiqueta = toggle.querySelector('.sr-only');
    if (etiqueta) etiqueta.textContent = (abrir ? toggle.dataset.cerrar : toggle.dataset.abrir) ?? '';
    document.body.style.overflow = abrir && !escritorio.matches ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => {
    abrirPanel(toggle.getAttribute('aria-expanded') !== 'true');
  });

  escritorio.addEventListener('change', () => abrirPanel(false));

  // Submenús (Apnea)
  const botones = document.querySelectorAll<HTMLButtonElement>('.menu__boton');

  function cerrarSubmenus(excepto?: HTMLButtonElement) {
    botones.forEach((b) => {
      if (b !== excepto) b.setAttribute('aria-expanded', 'false');
    });
  }

  botones.forEach((boton) => {
    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      cerrarSubmenus(boton);
      boton.setAttribute('aria-expanded', String(!abierto));
    });
  });

  // Cerrar al hacer clic fuera (escritorio)
  document.addEventListener('click', (e) => {
    if (!escritorio.matches) return;
    const objetivo = e.target as Node;
    botones.forEach((b) => {
      if (!b.parentElement?.contains(objetivo)) b.setAttribute('aria-expanded', 'false');
    });
  });

  // Cerrar submenú al salir con Tab (escritorio)
  botones.forEach((b) => {
    b.parentElement?.addEventListener('focusout', (e) => {
      if (!escritorio.matches) return;
      const siguiente = (e as FocusEvent).relatedTarget as Node | null;
      if (!siguiente || !b.parentElement?.contains(siguiente)) b.setAttribute('aria-expanded', 'false');
    });
  });

  // Escape cierra submenú y panel
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const abierto = Array.from(botones).find((b) => b.getAttribute('aria-expanded') === 'true');
    if (abierto) {
      abierto.setAttribute('aria-expanded', 'false');
      abierto.focus();
      return;
    }
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      abrirPanel(false);
      toggle.focus();
    }
  });
</script>
