---
import BotonWhatsapp from '../BotonWhatsapp.astro';
import Texto from '../Texto.astro';
import FotoPendiente from '../FotoPendiente.astro';
import type { PaginaHome } from '../../contenido/tipos';

interface Props {
  datos: PaginaHome['portada'];
}
const { datos } = Astro.props;
---
<section class="portada">
  <div class="contenedor portada__grid">
    <!-- Imagotipo a color: portada sobre fondo claro, con su área de protección -->
    <div class="portada__logo">
      <img src="/logos/aqura-imagotipo-color.png" alt={datos.logoAlt} width="882" height="1008" fetchpriority="high" />
    </div>

    <div class="portada__texto">
      <h1>{datos.titulo}</h1>
      <p class="entrada portada__frase"><Texto texto={datos.frase} /></p>
      <ul class="credenciales">
        {datos.credenciales.map((c, i) => <li class:list={{ 'credenciales__nombre': i === 0 }}>{c}</li>)}
      </ul>
      <BotonWhatsapp texto={datos.boton.texto} mensaje={datos.boton.mensaje} grande />
    </div>
  </div>
  <div class="contenedor portada__franja">
    <FotoPendiente archivo={datos.foto} proporcion="21 / 9" />
  </div>
</section>

<style>
  .portada {
    padding-block: var(--espacio-7) var(--espacio-8);
    background: linear-gradient(180deg, var(--color-blanco) 55%, rgb(68 216 197 / 0.10));
  }
  .portada__grid { display: grid; gap: var(--espacio-6); align-items: center; }

  .portada__logo { padding: var(--espacio-5); justify-self: center; }
  .portada__logo img { width: clamp(9rem, 42vw, 13rem); height: auto; }

  .portada__frase { margin-bottom: var(--espacio-5); }
  .portada__franja { margin-top: var(--espacio-8); }
  @media (max-width: 719px) {
    .portada__franja :global(.foto-pendiente) { aspect-ratio: 4 / 3 !important; }
  }

  .credenciales {
    list-style: none;
    margin: 0 0 var(--espacio-6);
    padding: var(--espacio-4) 0;
    border-block: 1px solid var(--color-borde);
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) 0;
    font-family: var(--font-titulos);
    font-size: var(--texto-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--color-azul-oscuro);
  }
  .credenciales li { margin: 0; }
  .credenciales li + li::before { content: '·'; margin-inline: 0.55em; color: var(--color-turquesa); }
  .credenciales__nombre { color: var(--color-texto); font-weight: 600; }

  @media (min-width: 960px) {
    .portada { padding-block: var(--espacio-9); }
    .portada__grid { grid-template-columns: 1.3fr 1fr; gap: var(--espacio-8); }
    .portada__logo { order: 2; padding: var(--espacio-7); }
    .portada__logo img { width: 17rem; }
  }
</style>
