---
import BotonWhatsapp from '../BotonWhatsapp.astro';
import FotoPendiente from '../FotoPendiente.astro';
import type { PaginaCursosAida } from '../../contenido/tipos';

interface Props {
  datos: PaginaCursosAida['encabezado'];
}
const { datos } = Astro.props;
---
<section class="encabezado">
  <div class="contenedor encabezado__grid">
    <div class="encabezado__texto">
      <span class="antetitulo">{datos.antetitulo}</span>
      <h1>{datos.titulo}</h1>
      <p class="entrada encabezado__frase">{datos.frase}</p>

      <ul class="credenciales">
        {datos.credenciales.map((c, i) => <li class:list={{ 'credenciales__nombre': i === 0 }}>{c}</li>)}
      </ul>

      <p class="encabezado__parrafo">{datos.parrafo}</p>
      <BotonWhatsapp texto={datos.boton.texto} mensaje={datos.boton.mensaje} grande />
    </div>

    <FotoPendiente archivo={datos.fotoArchivo} class="encabezado__foto" />
  </div>
</section>

<style>
  .encabezado {
    padding-block: var(--espacio-7) var(--espacio-8);
  }
  .encabezado__grid {
    display: grid;
    gap: var(--espacio-7);
    align-items: center;
  }
  .encabezado__frase { max-width: 34rem; margin-bottom: var(--espacio-6); }
  .encabezado__parrafo { max-width: var(--ancho-lectura); margin-bottom: var(--espacio-6); }

  .credenciales {
    list-style: none;
    margin: 0 0 var(--espacio-6);
    padding: var(--espacio-4) 0;
    border-block: 1px solid var(--color-borde);
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) 0;
    font-family: var(--font-titulos);
    font-size: var(--texto-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--color-azul-oscuro);
  }
  .credenciales li { margin: 0; }
  .credenciales li + li::before {
    content: '·';
    margin-inline: 0.55em;
    color: var(--color-turquesa);
  }
  .credenciales__nombre { color: var(--color-texto); font-weight: 600; }

  @media (min-width: 960px) {
    .encabezado { padding-block: var(--espacio-8) var(--espacio-9); }
    .encabezado__grid { grid-template-columns: 1.15fr 1fr; gap: var(--espacio-8); }
  }
</style>
