---
import type { PaginaCursosAida } from '../../contenido/tipos';

interface Props {
  datos: PaginaCursosAida['niveles'];
}
const { datos } = Astro.props;
const c = datos.columnas;
---
<section class="niveles seccion" aria-labelledby="t-niveles">
  <div class="contenedor">
    <h2 id="t-niveles">{datos.titulo}</h2>
    <p class="niveles__intro lectura">{datos.intro}</p>

    <table class="tabla">
      <thead>
        <tr>
          <th scope="col">{c.nivel}</th>
          <th scope="col">{c.paraQuien}</th>
          <th scope="col">{c.duracion}</th>
          <th scope="col">{c.profundidad}</th>
          <th scope="col">{c.requisito}</th>
          <th scope="col" class="tabla__num">{c.precio}</th>
        </tr>
      </thead>
      <tbody>
        {datos.filas.map((f) => (
          <tr>
            <th scope="row" class="tabla__nivel"><a href={`#${f.ancla}`}>{f.nivel}</a></th>
            <td data-etiqueta={c.paraQuien} class="tabla__para">{f.paraQuien}</td>
            <td data-etiqueta={c.duracion}>{f.duracion}</td>
            <td data-etiqueta={c.profundidad}>{f.profundidad}</td>
            <td data-etiqueta={c.requisito}>{f.requisito}</td>
            <td data-etiqueta={c.precio} class="tabla__num tabla__precio">{f.precio}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="niveles__nota">
      {datos.notaCrossover.antes} <a href="#crossover">{datos.notaCrossover.enlace}</a>
    </p>
  </div>
</section>

<style>
  .niveles { background: rgb(68 216 197 / 0.10); }
  .niveles__intro { margin-bottom: var(--espacio-6); }
  .niveles__nota { margin: var(--espacio-6) 0 0; }

  .tabla { width: 100%; border-collapse: collapse; }

  /* ---------- Celular: cada nivel es una tarjeta ---------- */
  .tabla thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .tabla, .tabla tbody, .tabla tr, .tabla th, .tabla td { display: block; }
  .tabla tr {
    margin-bottom: var(--espacio-4);
    padding: var(--espacio-5);
    background: var(--color-blanco);
    border-radius: var(--radio-md);
  }
  .tabla__nivel {
    margin-bottom: var(--espacio-2);
    font-family: var(--font-titulos);
    font-size: var(--titulo-4);
    font-weight: 600;
    text-align: left;
  }
  .tabla__nivel a { color: var(--color-texto); text-decoration: none; }
  .tabla__nivel a:hover { color: var(--color-azul-oscuro); text-decoration: underline; }
  .tabla td { padding: var(--espacio-2) 0; font-size: var(--texto-sm); }
  .tabla td + td { border-top: 1px solid var(--color-borde); }
  .tabla td::before {
    content: attr(data-etiqueta);
    display: block;
    font-family: var(--font-titulos);
    font-size: var(--texto-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-azul-oscuro);
  }
  .tabla__para { font-size: var(--texto-base) !important; }
  .tabla__para::before { display: none !important; }
  .tabla__precio { font-family: var(--font-titulos); font-weight: 600; font-size: var(--texto-base) !important; }

  /* ---------- Escritorio: tabla ---------- */
  @media (min-width: 960px) {
    .tabla { display: table; background: var(--color-blanco); border-radius: var(--radio-md); overflow: hidden; }
    .tabla thead { position: static; width: auto; height: auto; overflow: visible; clip: auto; display: table-header-group; }
    .tabla tbody { display: table-row-group; }
    .tabla tr { display: table-row; margin: 0; padding: 0; border-radius: 0; }
    .tabla th, .tabla td { display: table-cell; padding: var(--espacio-4) var(--espacio-4); vertical-align: top; text-align: left; }
    .tabla td + td { border-top: 0; }
    .tabla td::before { display: none; }
    .tabla tbody tr + tr > * { border-top: 1px solid var(--color-borde); }
    .tabla thead th {
      font-family: var(--font-titulos);
      font-size: var(--texto-xs);
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--color-azul-oscuro);
      border-bottom: 1.5px solid var(--color-aqua);
    }
    .tabla__nivel { margin: 0; font-size: var(--texto-base); white-space: nowrap; }
    .tabla td { font-size: var(--texto-sm); }
    .tabla__para { font-size: var(--texto-sm) !important; max-width: 16rem; }
    .tabla__num { text-align: right !important; white-space: nowrap; }
    .tabla__precio { font-size: var(--texto-sm) !important; }
  }
</style>
