---
import BotonWhatsapp from '../BotonWhatsapp.astro';
import FotoPendiente from '../FotoPendiente.astro';
import Texto from '../Texto.astro';
import type { PaginaEquipos } from '../../contenido/tipos';

interface Props {
  datos: PaginaEquipos['catalogo'];
  comoPedir: PaginaEquipos['comoPedir'];
}
const { datos, comoPedir } = Astro.props;
---
<section class="seccion catalogo" aria-labelledby="t-catalogo">
  <div class="contenedor">
    <h2 id="t-catalogo">{datos.titulo}</h2>
    <ul class="catalogo__grid">
      {datos.productos.map((p, i) => (
        <li>
          <article class="producto" aria-labelledby={`t-producto-${i}`}>
            <FotoPendiente archivo={p.fotoArchivo} />
            <div class="producto__cuerpo">
              <span class="producto__estado">{p.estado}</span>
              <h3 id={`t-producto-${i}`}>{p.nombre}</h3>
              <p>{p.texto}</p>
              <dl class="producto__datos">
                {p.datos.map((d) => (
                  <div><dt>{d.etiqueta}</dt><dd><Texto texto={d.valor} /></dd></div>
                ))}
              </dl>
              <BotonWhatsapp texto={p.boton.texto} mensaje={p.boton.mensaje} class="producto__boton" />
            </div>
          </article>
        </li>
      ))}
    </ul>

    <div class="catalogo__pedir">
      <h2 class="catalogo__pedir-titulo">{comoPedir.titulo}</h2>
      <p>{comoPedir.texto}</p>
    </div>
  </div>
</section>

<style>
  .catalogo { border-top: 1px solid var(--color-borde); }
  .catalogo__grid { list-style: none; margin: var(--espacio-6) 0 0; padding: 0; display: grid; gap: var(--espacio-6); }
  .catalogo__grid li + li { margin-top: 0; }

  .producto { display: grid; gap: var(--espacio-4); height: 100%; }
  .producto__cuerpo { display: flex; flex-direction: column; align-items: flex-start; }
  .producto__estado {
    display: inline-block;
    margin-bottom: var(--espacio-3);
    padding: 0.15rem 0.6rem;
    background: var(--color-lima);
    border-radius: var(--radio-pill);
    font-family: var(--font-titulos);
    font-size: var(--texto-xs);
    font-weight: 600;
    color: var(--color-texto);
  }
  .producto h3 { margin-bottom: var(--espacio-2); font-size: var(--titulo-3); }
  .producto__datos { display: grid; gap: var(--espacio-3); width: 100%; margin: 0 0 var(--espacio-5); }
  .producto__datos div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--espacio-2) var(--espacio-4);
    padding-bottom: var(--espacio-2);
    border-bottom: 1px dashed var(--color-borde);
  }
  .producto__datos dt { font-family: var(--font-titulos); font-size: var(--texto-sm); font-weight: 600; }
  .producto__datos dd { margin: 0; font-size: var(--texto-sm); }
  :global(.producto__boton) { margin-top: auto; }

  .catalogo__pedir {
    margin-top: var(--espacio-8);
    padding-top: var(--espacio-6);
    border-top: 1px solid var(--color-borde);
  }
  .catalogo__pedir-titulo { font-size: var(--titulo-4); }
  .catalogo__pedir p { margin: 0; }

  @media (min-width: 720px) {
    .catalogo__grid { grid-template-columns: repeat(2, 1fr); gap: var(--espacio-7); }
  }
</style>
