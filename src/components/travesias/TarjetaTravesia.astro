---
import Texto from '../Texto.astro';
import FotoPendiente from '../FotoPendiente.astro';
import { idiomaDesdeUrl, rutaEn } from '../../i18n';
import type { PaginaTravesias, Travesia } from '../../contenido/tipos';

interface Props {
  travesia: Travesia;
  etiquetas: PaginaTravesias['etiquetas'];
}
const { travesia: t, etiquetas: e } = Astro.props;
const idioma = idiomaDesdeUrl(Astro.url);
---
<a class="tarjeta-travesia" href={rutaEn(idioma, `/travesias/${t.slug}`)}>
  <FotoPendiente archivo={t.fotoArchivo} class="tarjeta-travesia__foto" />
  <span class="tarjeta-travesia__tipo"><span class="sr-only">{e.tipo}: </span><Texto texto={t.tipo} /></span>
  <h3 class="tarjeta-travesia__nombre">{t.nombre}</h3>
  <p class="tarjeta-travesia__datos">
    <Texto texto={t.lugar} /> · <Texto texto={t.fecha} />
  </p>
  <span class="tarjeta-travesia__ver">
    {e.ver}
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .tarjeta-travesia {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding: var(--espacio-6) var(--espacio-5);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-md);
    color: var(--color-texto);
    text-decoration: none;
    transition: border-color var(--transicion), transform var(--transicion);
  }
  .tarjeta-travesia:hover { border-color: var(--color-aqua); transform: translateY(-3px); color: var(--color-texto); }
  .tarjeta-travesia :global(.tarjeta-travesia__foto) { margin-bottom: var(--espacio-4); }

  .tarjeta-travesia__tipo {
    margin-bottom: var(--espacio-4);
    padding: 0.15rem 0.6rem;
    background: rgb(68 216 197 / 0.18);
    border-radius: var(--radio-pill);
    font-family: var(--font-titulos);
    font-size: var(--texto-xs);
    font-weight: 600;
  }
  .tarjeta-travesia__nombre { margin-bottom: var(--espacio-3); font-size: var(--titulo-4); line-height: 1.3; }
  .tarjeta-travesia__datos { margin-bottom: var(--espacio-5); font-size: var(--texto-sm); color: var(--color-azul-oscuro); }
  .tarjeta-travesia__ver {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    margin-top: auto;
    font-family: var(--font-titulos);
    font-size: var(--texto-sm);
    font-weight: 600;
    color: var(--color-azul-oscuro);
  }
  .tarjeta-travesia__ver svg { width: 1.1em; height: 1.1em; transition: transform var(--transicion); }
  .tarjeta-travesia:hover .tarjeta-travesia__ver svg { transform: translateX(4px); }
</style>
