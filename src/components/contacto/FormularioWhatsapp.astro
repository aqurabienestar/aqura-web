---
// Formulario sin servidor: arma el texto y abre WhatsApp. No guarda ni envía datos a otro lugar.
import IconoWhatsapp from '../IconoWhatsapp.astro';
import { WHATSAPP_NUMERO, idiomaDesdeUrl, textos } from '../../i18n';
import type { PaginaContacto } from '../../contenido/tipos';

interface Props {
  datos: PaginaContacto['formulario'];
}
const { datos } = Astro.props;
const t = textos(idiomaDesdeUrl(Astro.url));
---
<form
  class="formulario"
  data-numero={WHATSAPP_NUMERO}
  data-saludo={datos.saludo}
  aria-labelledby="t-formulario"
  aria-describedby="formulario-ayuda"
>
  <h2 id="t-formulario" class="formulario__titulo">{datos.titulo}</h2>
  <p id="formulario-ayuda" class="formulario__ayuda">{datos.explicacion}</p>

  <label for="f-nombre">{datos.nombre}</label>
  <input id="f-nombre" name="nombre" type="text" autocomplete="name" required />

  <label for="f-mensaje">{datos.mensaje}</label>
  <textarea id="f-mensaje" name="mensaje" rows="5" required></textarea>

  <button class="btn btn--primario btn--grande" type="submit">
    <IconoWhatsapp />
    {datos.enviar}
    <span class="sr-only">{t.ui.pestanaNueva}</span>
  </button>
</form>

<style>
  .formulario { display: grid; gap: var(--espacio-2); }
  .formulario__titulo { font-size: var(--titulo-3); font-weight: 500; margin-bottom: var(--espacio-2); }
  .formulario__ayuda { margin-bottom: var(--espacio-4); font-size: var(--texto-sm); color: var(--color-azul-oscuro); }

  label {
    margin-top: var(--espacio-3);
    font-family: var(--font-titulos);
    font-size: var(--texto-sm);
    font-weight: 600;
  }
  input, textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid rgb(1 65 84 / 0.3);
    border-radius: var(--radio-sm);
    background: var(--color-blanco);
    color: var(--color-texto);
    font-family: var(--font-cuerpo);
    font-size: var(--texto-base);
    line-height: 1.5;
  }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--color-azul-oscuro); outline-offset: 1px; border-color: transparent; }
  textarea { resize: vertical; min-height: 8rem; }
  button { justify-self: start; margin-top: var(--espacio-5); }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form.formulario').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const datos = new FormData(form);
      const nombre = String(datos.get('nombre') ?? '').trim();
      const mensaje = String(datos.get('mensaje') ?? '').trim();
      const texto = `${form.dataset.saludo} ${nombre}. ${mensaje}`;
      window.open(`https://wa.me/${form.dataset.numero}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
    });
  });
</script>
