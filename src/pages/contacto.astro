---
import BaseLayout from '../layouts/BaseLayout.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import FormularioWhatsapp from '../components/contacto/FormularioWhatsapp.astro';
import { URL_INSTAGRAM, USUARIO_INSTAGRAM, WHATSAPP_VISIBLE, enlaceWhatsapp, textos } from '../i18n';
import c from '../contenido/es/contacto';

const t = textos('es');
---
<BaseLayout titulo={c.meta.titulo} descripcion={c.meta.descripcion} whatsappMensaje={c.meta.whatsapp} sinAlterno>
  <EncabezadoPagina datos={c.encabezado} />

  <div class="contenedor contacto__grid">
    <section aria-labelledby="t-canales">
      <h2 id="t-canales" class="contacto__titulo">{c.canales.titulo}</h2>
      <ul class="canales">
        <li>
          <span class="canales__etiqueta">{c.canales.whatsapp}</span>
          <a href={enlaceWhatsapp(c.meta.whatsapp)} target="_blank" rel="noopener">
            {WHATSAPP_VISIBLE}<span class="sr-only"> {t.ui.pestanaNueva}</span>
          </a>
        </li>
        <li>
          <span class="canales__etiqueta">{c.canales.instagram}</span>
          <a href={URL_INSTAGRAM} target="_blank" rel="noopener">
            {USUARIO_INSTAGRAM}<span class="sr-only"> {t.ui.pestanaNueva}</span>
          </a>
        </li>
      </ul>
    </section>

    <FormularioWhatsapp datos={c.formulario} />
  </div>
</BaseLayout>

<style>
  .contacto__grid {
    display: grid;
    gap: var(--espacio-8);
    padding-block: var(--espacio-7) var(--espacio-9);
    border-top: 1px solid var(--color-borde);
  }
  .contacto__titulo { font-size: var(--titulo-3); font-weight: 500; }

  .canales { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--espacio-5); }
  .canales li + li { margin-top: 0; }
  .canales__etiqueta {
    display: block;
    font-family: var(--font-titulos);
    font-size: var(--texto-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-azul-oscuro);
  }
  .canales a { font-size: var(--texto-lg); }

  @media (min-width: 960px) {
    .contacto__grid { grid-template-columns: 1fr 1.5fr; gap: var(--espacio-9); }
  }
</style>
